{
  "expo": {
    "name": "SpdRdr",
    "slug": "SpdRdr",
    "version": "1.0.5",
    "orientation": "portrait",
    "icon": "./assets/images/Miami_potato_square.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/Miami_potato.png",
      "resizeMode": "contain",
      "backgroundColor": "#eee"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "usesIcloudStorage": true
    },
    "android": {
      "compileSdkVersion": 36,
      "targetSdkVersion": 36,
      "versionCode": 10,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/Miami_potato_square.png",
        "backgroundColor": "#eee"
      },
      "package": "com.usarneme.spdrdr"
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "7bb4fa88-ce81-4578-bdfd-e45a8255aa52"
      }
    }
  }
}
